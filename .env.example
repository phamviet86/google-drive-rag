# Copy to .env and fill in. Leave a value empty to skip it. Never commit .env.

# A value set here always wins over what the CLI or an admin tool stored; admin tools refuse to
# change it. Leave a line empty to manage that setting with the CLI or the admin tools.

# 1) Semantic search (optional). Empty key = full-text search only.
#    Empty address/model = https://openrouter.ai/api/v1 and qwen/qwen3-embedding-8b.
GDRAG_EMBEDDING_API_KEY=
GDRAG_EMBEDDING_BASE_URL=
GDRAG_EMBEDDING_MODEL=
# 1 = allow an embedding server on this machine or the local network (plain http only to a
# numeric address such as http://192.168.1.5:8080/v1). Otherwise https to a public host only.
GDRAG_ALLOW_LOCAL_EMBEDDINGS=

# 2) Google access: path INSIDE the container to the JSON file placed in ./secrets
#    (service-account key, or OAuth "Desktop app" client; OAuth still needs `auth google` once).
GDRAG_GOOGLE_CREDENTIALS=

# 3) Drive links, separated by spaces or commas.
GDRAG_DRIVE_LINKS=

# 4) Local folder sources (optional): a folder on this server, mounted read-only as /local
#    inside the container. Empty = ./local next to docker-compose.yml. Add a folder from it
#    with add_source local:<path inside it> (or: gdrive-rag source add local:<path>).
#    Do not set GDRAG_LOCAL_ROOT here: in Docker it is always /local.
GDRAG_LOCAL_HOST_DIR=

# How often to check Drive and local folders for changes (minutes).
GDRAG_SYNC_INTERVAL_MINUTES=15

# Languages for reading scans (Tesseract codes joined with +). Each needs its
# tesseract-ocr-<code> package in the Dockerfile.
GDRAG_OCR_LANGS=vie+eng

# Memory ceiling for the container (Docker units: 4g, 8g, ...). Default 8g.
GDRAG_MEMORY_LIMIT=8g

# Admin MCP tools (Google access, embedding endpoint) for Claude. The source tools
# (add_source, remove_source, set_path_rules) are always available.
# Off unless 1. A document could try to talk Claude into misusing them: enable only when needed.
GDRAG_ADMIN_TOOLS=
