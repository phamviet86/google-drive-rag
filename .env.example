# Copy to .env and fill in. Leave a value empty to skip it. Never commit .env.

# 1) Semantic search (optional). Empty key = full-text search only.
GDRAG_EMBEDDING_API_KEY=
GDRAG_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
GDRAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# 2) Google access: path INSIDE the container to the JSON file placed in ./secrets
#    (service-account key, or OAuth "Desktop app" client; OAuth still needs `auth google` once).
GDRAG_GOOGLE_CREDENTIALS=

# 3) Drive links, separated by spaces or commas.
GDRAG_DRIVE_LINKS=

# How often to check Drive for changes (minutes).
GDRAG_SYNC_INTERVAL_MINUTES=15

# Languages for reading scans (Tesseract codes joined with +). Each needs its
# tesseract-ocr-<code> package in the Dockerfile.
GDRAG_OCR_LANGS=vie+eng

# Memory ceiling for the container (Docker units: 4g, 8g, ...). Default 8g.
GDRAG_MEMORY_LIMIT=8g
